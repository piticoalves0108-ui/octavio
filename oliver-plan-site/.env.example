# Marca ativa: "oliver" (Oliver Plan) ou "atelie" (Ateliê Forma)
NEXT_PUBLIC_BRAND=oliver

# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.oliverplan.com.br

# Opcional: webhooks para receber leads do formulário e da newsletter
# (Zapier, Make, n8n, planilha, CRM...). Sem eles, os dados só aparecem no log do servidor.
LEADS_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
