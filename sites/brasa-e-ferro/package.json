{
  "name": "brasa-e-ferro",
  "private": true,
  "version": "1.0.0",
  "description": "Site one-page da hamburgueria artesanal Brasa & Ferro: React, Vite, Three.js, GSAP e Tailwind.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:html": "node scripts/build-html.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "assets": "node scripts/render-assets.mjs",
    "foto": "node scripts/foto.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.56.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
