# Copie para .env.local e preencha.

# Domínio final do site, sem barra no fim. Usado no canonical, no Open Graph,
# no sitemap e no JSON-LD. Na Vercel, se ficar vazio, o site usa o domínio
# de produção do projeto (VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_SITE_URL=

# GA4 (opcional). Se preencher, os cliques de conversão também vão para o GA4.
NEXT_PUBLIC_GA_ID=

# Instagram (opcional). Token de longa duração da Instagram API with Instagram
# Login (conta profissional). Com ele, a galeria puxa as últimas fotos do
# @churrasquinhodobruce e se atualiza a cada hora. Sem ele, a galeria usa as
# fotos de /public/images/galeria.
INSTAGRAM_ACCESS_TOKEN=

# Mostra os marcadores {{CONFIRMAR: ...}} na tela também em produção
# (útil num deploy de prévia para o dono revisar). Em desenvolvimento eles
# já aparecem sempre.
NEXT_PUBLIC_MOSTRAR_PENDENCIAS=
