{
  "name": "eclipse-arcano",
  "private": true,
  "version": "0.1.0",
  "description": "Eclipse Arcano: O Mago do Tempo Perdido — RPG de ação 3D em mundo aberto (cyber-medieval)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node scripts/benchmark.mjs",
    "smoke": "node scripts/smoke.mjs",
    "bench:gpu": "node scripts/benchmark.mjs --gpu",
    "bench:memory": "node tests/perf.memory.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  }
}
