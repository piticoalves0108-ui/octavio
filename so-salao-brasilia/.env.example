# URL pública do site (sem barra no final). Usada no sitemap, no Open Graph e no JSON-LD.
# {{CONFIRMAR: domínio próprio do site}}
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Opcional: ID do Google Analytics 4 (ex.: G-XXXXXXXXXX). Sem ele, só o Vercel Analytics mede os cliques.
NEXT_PUBLIC_GA_ID=

# Liga a rota /captura em produção (só para gerar pôsteres e renders com `npm run capture`).
ENABLE_CAPTURE=
