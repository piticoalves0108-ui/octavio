# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Settings > Environment Variables).

# false = publicação (o build falha se sobrar {{CONFIRMAR}}; libera indexação).
# Sem definir = modo prévia (marcadores visíveis, noindex).
NEXT_PUBLIC_MODO_PREVIA=

# Domínio final do site, sem barra no fim. Ex.: https://www.seudominio.com.br
NEXT_PUBLIC_SITE_URL=

# Opcional: Google Analytics 4 (G-XXXXXXXXXX). O Vercel Analytics já vem ligado.
NEXT_PUBLIC_GA_ID=

# Opcional: token da Instagram API (conta profissional) para puxar a galeria.
INSTAGRAM_ACCESS_TOKEN=
